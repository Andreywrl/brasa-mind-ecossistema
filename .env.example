# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# MySQL 8
DATABASE_URL=mysql://user:password@localhost:3306/brasamind

# Google OAuth (optional: hides Google button when unset)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Asaas sandbox (optional: payments disabled when unset)
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
# Em produção, ASAAS_WEBHOOK_TOKEN é obrigatório.

# Vercel Blob (optional: upload disabled when unset). Store pode ser privada.
BLOB_READ_WRITE_TOKEN=

# Sentry (optional: tracking disabled when unset)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Transactional email (optional: password reset shows UI without sending)
EMAIL_FROM=Brasamind <noreply@brasamind.com.br>
RESEND_API_KEY=

# Seed passwords (local only)
SEED_MEMBER_PASSWORD=membro123
SEED_ADMIN_PASSWORD=admin123
