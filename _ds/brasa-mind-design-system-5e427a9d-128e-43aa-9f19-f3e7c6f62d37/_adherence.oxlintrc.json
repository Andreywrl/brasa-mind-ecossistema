{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": [
          {
            "element": "button",
            "message": "Use <Button> from the design system instead of <button>."
          },
          {
            "element": "input",
            "message": "Use <Input> from the design system instead of <input>."
          },
          {
            "element": "select",
            "message": "Use <Select> from the design system instead of <select>."
          },
          {
            "element": "table",
            "message": "Use <Table> from the design system instead of <table>."
          }
        ]
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/general/Avatar/**",
              "components/general/AvatarFallback/**",
              "components/general/AvatarImage/**",
              "components/general/Badge/**",
              "components/general/BrasaMindLogo/**",
              "components/general/BrasaMindSymbol/**",
              "components/general/Button/**",
              "components/general/Card/**",
              "components/general/CardContent/**",
              "components/general/CardDescription/**",
              "components/general/CardFooter/**",
              "components/general/CardHeader/**",
              "components/general/CardTitle/**",
              "components/general/Input/**",
              "components/general/Label/**",
              "components/general/Select/**",
              "components/general/SelectContent/**",
              "components/general/SelectGroup/**",
              "components/general/SelectItem/**",
              "components/general/SelectTrigger/**",
              "components/general/SelectValue/**",
              "components/general/Separator/**",
              "components/general/Table/**",
              "components/general/TableBody/**",
              "components/general/TableCell/**",
              "components/general/TableHead/**",
              "components/general/TableHeader/**",
              "components/general/TableRow/**",
              "components/general/Tabs/**",
              "components/general/TabsContent/**",
              "components/general/TabsList/**",
              "components/general/TabsTrigger/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Barlow|Barlow Semi Condensed|Inter|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Barlow, Barlow Semi Condensed, Inter, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:style|className|id|children|asChild|ref|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: style, className, id, children, asChild, ref."
      },
      {
        "selector": "JSXOpeningElement[name.name='AvatarFallback'] > JSXAttribute > JSXIdentifier[name!=/^(?:style|className|id|children|asChild|delayMs|ref|key|ref|className|style|children)$/]",
        "message": "<AvatarFallback> doesn't accept that prop. Declared props: style, className, id, children, asChild, delayMs, ref."
      },
      {
        "selector": "JSXOpeningElement[name.name='AvatarImage'] > JSXAttribute > JSXIdentifier[name!=/^(?:style|className|id|children|asChild|ref|key|ref|className|style|children)$/]",
        "message": "<AvatarImage> doesn't accept that prop. Declared props: style, className, id, children, asChild, ref."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|id|style|children|variant|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: className, id, style, children, variant."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|ember|success|destructive|fire|warning|info)$/]",
        "message": "<Badge> variant must be one of 'default' | 'ember' | 'success' | 'destructive' | 'fire' | 'warning' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrasaMindLogo'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|tone|tagline|className|id|style|children|key|ref|className|style|children)$/]",
        "message": "<BrasaMindLogo> doesn't accept that prop. Declared props: size, tone, tagline, className, id, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrasaMindLogo'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:laranja|branco|preto)$/]",
        "message": "<BrasaMindLogo> tone must be one of 'laranja' | 'branco' | 'preto'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrasaMindSymbol'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|tone|className|id|style|children|key|ref|className|style|children)$/]",
        "message": "<BrasaMindSymbol> doesn't accept that prop. Declared props: size, tone, className, id, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrasaMindSymbol'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:laranja|branco|preto)$/]",
        "message": "<BrasaMindSymbol> tone must be one of 'laranja' | 'branco' | 'preto'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:asChild|className|id|style|children|variant|size|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: asChild, className, id, style, children, variant, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:link|default|ember|success|destructive|secondary|outline|ghost)$/]",
        "message": "<Button> variant must be one of 'link' | 'default' | 'ember' | 'success' | 'destructive' | 'secondary' | 'outline' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:default|sm|lg|icon)$/]",
        "message": "<Button> size must be one of 'default' | 'sm' | 'lg' | 'icon'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|id|style|children|ref|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: className, id, style, children, ref."
      },
      {
        "selector": "JSXOpeningElement[name.name='CardContent'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|id|style|children|ref|key|ref|className|style|children)$/]",
        "message": "<CardContent> doesn't accept that prop. Declared props: className, id, style, children, ref."
      },
      {
        "selector": "JSXOpeningElement[name.name='CardDescription'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|id|style|children|ref|key|ref|className|style|children)$/]",
        "message": "<CardDescription> doesn't accept that prop. Declared props: className, id, style, children, ref."
      },
      {
        "selector": "JSXOpeningElement[name.name='CardFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|id|style|children|ref|key|ref|className|style|children)$/]",
        "message": "<CardFooter> doesn't accept that prop. Declared props: className, id, style, children, ref."
      },
      {
        "selector": "JSXOpeningElement[name.name='CardHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|id|style|children|ref|key|ref|className|style|children)$/]",
        "message": "<CardHeader> doesn't accept that prop. Declared props: className, id, style, children, ref."
      },
      {
        "selector": "JSXOpeningElement[name.name='CardTitle'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|id|style|children|ref|key|ref|className|style|children)$/]",
        "message": "<CardTitle> doesn't accept that prop. Declared props: className, id, style, children, ref."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|id|style|children|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: className, id, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Label'] > JSXAttribute > JSXIdentifier[name!=/^(?:style|className|id|children|asChild|ref|key|ref|className|style|children)$/]",
        "message": "<Label> doesn't accept that prop. Declared props: style, className, id, children, asChild, ref."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|open|defaultOpen|dir|name|autoComplete|disabled|required|form|value|defaultValue|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: children, open, defaultOpen, dir, name, autoComplete, disabled, required, form, value, defaultValue."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute[name.name='dir'] > Literal[value!=/^(?:ltr|rtl)$/]",
        "message": "<Select> dir must be one of 'ltr' | 'rtl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectContent'] > JSXAttribute > JSXIdentifier[name!=/^(?:style|className|id|children|asChild|side|sideOffset|align|alignOffset|arrowPadding|avoidCollisions|collisionBoundary|collisionPadding|sticky|hideWhenDetached|updatePositionStrategy|forceMount|position|ref|key|ref|className|style|children)$/]",
